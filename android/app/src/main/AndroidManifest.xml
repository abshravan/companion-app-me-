<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Foreground service so the link survives the screen turning off. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Needed to show the ongoing foreground-service notification on API 33+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Bluetooth permissions are contributed by the :bluetooth library manifest. -->

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@android:drawable/stat_sys_data_bluetooth"
        android:supportsRtl="true"
        android:theme="@style/Theme.RelayME">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".RelayService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

    </application>

</manifest>
